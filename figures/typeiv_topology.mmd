---
config:
  theme: base
  themeVariables:
    fontFamily: "Arial, Helvetica, 'Liberation Sans', sans-serif"
    fontSize: "15px"
    lineColor: "#555555"
    primaryTextColor: "#111111"
  flowchart:
    curve: basis
    nodeSpacing: 34
    rankSpacing: 46
    padding: 12
---
flowchart LR
    FS["<b>Freestream inflow</b><br/>M<sub>∞</sub> = 8.03"]:::free
    IS["<b>Incident shock</b><br/>β = 18.1°,  θ = 12.5°"]:::shock
    PS["<b>Post-shock inflow</b><br/>M<sub>2</sub> = 5.25"]:::post
    UB["<b>Upper bow shock</b><br/>near-normal"]:::shock
    LB["<b>Lower bow shock</b>"]:::shock
    T1(("<b>T<sub>1</sub></b><br/>upper triple<br/>point")):::tp
    TS["<b>Transmitted shock</b>"]:::shock
    T2(("<b>T<sub>2</sub></b><br/>lower triple<br/>point")):::tp
    JET["<b>Supersonic jet</b><br/>bounded by shear layers<br/>from T<sub>1</sub> and T<sub>2</sub>"]:::jet
    JBS["<b>Jet bow shock</b>"]:::shock
    WALL["<b>Jet impingement</b><br/>no-slip wall, T<sub>w</sub> = 294 K<br/>peak p<sub>w</sub> and q<sub>w</sub>"]:::wall

    FS --> UB
    FS --> IS
    IS --> PS
    PS --> LB
    UB --> T1
    IS --> T1
    T1 --> TS
    TS --> T2
    LB --> T2
    T1 -.-> JET
    T2 -.-> JET
    JET --> JBS
    JBS --> WALL

    classDef free  fill:#e8f0fa,stroke:#1a5fa8,color:#1a5fa8,stroke-width:1.6px
    classDef post  fill:#e6f4ee,stroke:#0e8a62,color:#0e8a62,stroke-width:1.6px
    classDef shock fill:#ffffff,stroke:#111111,color:#111111,stroke-width:1.6px
    classDef tp    fill:#111111,stroke:#111111,color:#ffffff
    classDef jet   fill:#fff4e5,stroke:#b06a10,color:#6b3f08,stroke-width:1.6px
    classDef wall  fill:#e4e4e4,stroke:#111111,color:#111111,stroke-width:2.2px
